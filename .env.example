# Frontend (copy to frontend/.env if needed)
VITE_API_BASE_URL=http://localhost:8080/api/v1
# true: dùng mock data (chưa cần BE) | false: gọi API thật
VITE_USE_MOCK=true
# Backend 
DB_URL=jdbc:mysql://localhost:3306/warehouse_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=warehouse_app
DB_PASSWORD=replace_with_your_local_mysql_password
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password
FRONTEND_BASE_URL=http://localhost:5173

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_MOCK_ENABLED=false

ZONE_A_CAPACITY_M3=0
ZONE_B_CAPACITY_M3=0
ZONE_C_CAPACITY_M3=0

JWT_SECRET=replace_with_your_jwt_secret
